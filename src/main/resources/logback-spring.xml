<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!--
      重要说明：
      - MCP 的 stdio 传输使用 stdout 作为协议输出通道
      - 因此在 stdio profile 下，把常规日志输出到 STDERR，避免污染协议数据

      SQL 审计日志：
      - 统一使用 logger：SQL_AUDIT
      - 以 JSON 行格式输出到独立文件 logs/sql-audit.log，便于检索与追踪
    -->

    <!-- 日志目录：默认当前工作目录下 logs/；可通过环境变量 LOG_PATH 覆盖 -->
    <property name="LOG_PATH" value="${LOG_PATH:-logs}"/>

    <!-- SQL 审计日志：按天和大小滚动，限制保留时间与磁盘占用。 -->
    <appender name="SQL_AUDIT_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/sql-audit.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/sql-audit.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <charset>UTF-8</charset>
            <!-- 每条日志一行 JSON，便于机器检索与处理 -->
            <pattern>%msg%n</pattern>
        </encoder>
    </appender>

    <!-- 将 SQL_AUDIT logger 绑定到独立文件，避免与业务日志混淆 -->
    <logger name="SQL_AUDIT" level="INFO" additivity="false">
        <appender-ref ref="SQL_AUDIT_FILE"/>
    </logger>

    <springProfile name="stdio">
        <appender name="CONSOLE_ERR" class="ch.qos.logback.core.ConsoleAppender">
            <target>System.err</target>
            <encoder>
                <charset>UTF-8</charset>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] [request=%X{requestId:-} job=%X{jobId:-}] %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE_ERR"/>
        </root>
    </springProfile>

    <springProfile name="!stdio">
        <appender name="CONSOLE_OUT" class="ch.qos.logback.core.ConsoleAppender">
            <target>System.out</target>
            <encoder>
                <charset>UTF-8</charset>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] [request=%X{requestId:-} job=%X{jobId:-}] %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE_OUT"/>
        </root>
    </springProfile>
</configuration>
